# Скопируйте в .env (cp .env.example .env). Для всех переменных есть значения по умолчанию,
# так что docker compose поднимется и без .env.

# --- PostgreSQL ---
POSTGRES_USER=scooter
POSTGRES_PASSWORD=scooter
POSTGRES_DB=scooter
# Порт Postgres на хосте (внутри compose-сети всегда 5432)
POSTGRES_PORT=5432
# Хост Postgres для запуска бэкенда без Docker (в compose переопределяется на db)
POSTGRES_HOST=localhost

# --- Порты сервисов на хосте ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Backend ---
# true включает SQL-логи SQLAlchemy
DEBUG=false
