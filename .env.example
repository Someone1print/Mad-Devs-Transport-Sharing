# Скопируйте в .env (cp .env.example .env). Для всех переменных есть значения по умолчанию,
# так что docker compose поднимется и без .env.

# --- PostgreSQL ---
POSTGRES_USER=scooter
POSTGRES_PASSWORD=scooter
POSTGRES_DB=scooter
# Порт Postgres на хосте (внутри compose-сети всегда 5432)
POSTGRES_PORT=5432
# Хост Postgres для запуска бэкенда без Docker (в compose переопределяется на db)
POSTGRES_HOST=localhost

# --- Порты сервисов на хосте ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Backend ---
# true включает SQL-логи SQLAlchemy
DEBUG=false
# Самокат с зарядом строго ниже порога (в процентах) становится недоступным
LOW_BATTERY_THRESHOLD=15
# Бронь: длительность, за сколько секунд до снятия предупредить, как часто фоновая задача
# проверяет expires_at. Для быстрой проверки можно поставить, например, 60 / 20 / 1
BOOKING_TTL_SECONDS=900
BOOKING_WARN_BEFORE_SECONDS=180
BOOKING_SWEEP_INTERVAL_SECONDS=2
# Тарифы поездки, сом за минуту езды и за минуту паузы (оплата посекундная, округление до копейки)
RIDE_RATE_PER_MINUTE=5.00
PAUSE_RATE_PER_MINUTE=1.50
# Поездка завершается сама, когда телеметрия приносит заряд строго ниже порога (не выше LOW_BATTERY_THRESHOLD)
RIDE_AUTO_FINISH_BATTERY=10
# Часовой пояс для времени в письмах (API отдаёт время в UTC)
LOCAL_TIMEZONE=Asia/Bishkek
# При сохранении адреса для чеков сервер спрашивает DNS, принимает ли домен почту (MX, иначе A/AAAA):
# gmail.con отбивается с подсказкой. Без сети адрес принимается с предупреждением в логе.
# false выключает проверку (в CI и тестах она выключена)
EMAIL_DOMAIN_CHECK=true
# Сколько секунд ждать ответа DNS, прежде чем принять адрес без проверки
EMAIL_DOMAIN_CHECK_TIMEOUT_SECONDS=2
# Сессия живёт столько дней с момента входа (cookie и запись в базе)
SESSION_TTL_DAYS=30
# true ставит cookie сессии флаг Secure — только за HTTPS; для http://localhost оставьте false
SESSION_COOKIE_SECURE=false
# Минимальная длина пароля (других требований нет)
PASSWORD_MIN_LENGTH=8

# --- Simulator ---
# Сколько самокатов едут одновременно и период отправки телеметрии (секунды)
SIM_ACTIVE_SCOOTERS=6
SIM_INTERVAL_SECONDS=1.5
# Дополнительный расход заряда у самоката в поездке пользователя, % в минуту (для демо автозавершения — 30)
SIM_USER_RIDE_DRAIN_PER_MINUTE=0.5
# Остальные ручки симулятора (значения по умолчанию; описание — в README, раздел «Симулятор»)
SIM_SPEED_KMH=40
SIM_DRAIN_PER_KM=4
SIM_RECHARGE_SECONDS=180
SIM_MIN_RIDE_BATTERY=20
SIM_HEARTBEAT_TICKS=20
SIM_HELD_HEARTBEAT_TICKS=2
SIM_REFRESH_TICKS=2
